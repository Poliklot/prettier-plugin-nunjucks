{
  "name": "prettier-plugin-nunjucks",
  "version": "0.1.6",
  "description": "Prettier plugin for Nunjucks templates (.njk, .nunjucks, .nunj)",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "require": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Poliklot/prettier-plugin-nunjucks.git"
  },
  "bugs": {
    "url": "https://github.com/Poliklot/prettier-plugin-nunjucks/issues"
  },
  "homepage": "https://github.com/Poliklot/prettier-plugin-nunjucks#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "nunjucks",
    "njk",
    "jinja",
    "html",
    "formatter",
    "eleventy",
    "11ty"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test && node scripts/run-fuzz-check.mjs",
    "corpus:check": "node scripts/run-corpus-check.mjs",
    "corpus:oss": "node scripts/run-oss-corpus-check.mjs",
    "fuzz:parser": "npm run build && node scripts/run-fuzz-check.mjs",
    "format:nunjucks-tree": "node scripts/format-nunjucks-tree.mjs",
    "smoke:install": "node scripts/install-smoke.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0"
  },
  "dependencies": {
    "template-format-core": "^0.1.1"
  }
}
